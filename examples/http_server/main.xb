import "server.xb"
import "http.xb"
import "socket.xb"
import "sys.xb"
import "gc.xb"

print("==================================================")
print("     xlang Production Demo: HTTP Web Server       ")
print("  Native Micro-Framework, REST API & Benchmarks   ")
print("==================================================")

# Step 1: Initialize HTTP Web Server
HttpServer server
int port = 18080
int rc = server.init("127.0.0.1", port)
if (rc < 0) {
    print("FATAL: Failed to bind HTTP server to port %d (rc: %d)", port, rc)
    exit(1)
}

print("[1] HTTP Server successfully bound to http://127.0.0.1:%d", port)
print("    Listening on TCP backlog 32 with SO_REUSEADDR enabled.")

# Helper to send an HTTP request and get server response via loopback TCP
string do_request(string req_text) {
    int client = socket_create("tcp")
    socket_connect(client, "127.0.0.1", 18080)
    socket_send(client, req_text)
    server.accept_and_serve()
    string resp = socket_recv(client, 4096)
    socket_close(client)
    return resp
}

# Step 2: Automated Route Verification
print("\n[2] Executing Automated HTTP Test Suite...")

# Test 2.1: GET / (HTML Dashboard)
print("    --> Testing GET / (HTML Landing Page)...")
string req1 = "GET / HTTP/1.1\r\nHost: 127.0.0.1:18080\r\nUser-Agent: xlang-client\r\n\r\n"
string resp1 = do_request(req1)
int ok1 = index_of(resp1, "200 OK")
int html1 = index_of(resp1, "Welcome to xlang HTTP Web Server!")
if (ok1 >= 0) {
    if (html1 >= 0) {
        print("        [PASS] Status: 200 OK | HTML Dashboard correctly rendered")
    }
    else {
        print("        [FAIL] Missing HTML body content")
    }
}
else {
    print("        [FAIL] Expected 200 OK")
}

# Test 2.2: GET /health (JSON Health Probe)
print("    --> Testing GET /health (JSON Health Check)...")
string req2 = "GET /health HTTP/1.1\r\nHost: 127.0.0.1:18080\r\n\r\n"
string resp2 = do_request(req2)
int ok2 = index_of(resp2, "200 OK")
int json2 = index_of(resp2, "\"status\":\"UP\"")
if (ok2 >= 0) {
    if (json2 >= 0) {
        print("        [PASS] Status: 200 OK | Health payload: status=UP")
    }
    else {
        print("        [FAIL] Missing UP status in health check")
    }
}
else {
    print("        [FAIL] Expected 200 OK")
}

