int s = socket_create("tcp")
assert(s >= 0, "TCP socket created successfully")
if (s >= 0) {
    print("TCP socket created successfully")
} else {
    print("Failed to create TCP socket")
}

int rc = socket_close(s)
assert(rc == 0, "Socket closed successfully")
if (rc == 0) {
    print("Socket closed successfully")
} else {
    print("Failed to close socket")
}

int u = socket_create("udp")
assert(u >= 0, "UDP socket created successfully")
if (u >= 0) {
    print("UDP socket created successfully")
} else {
    print("Failed to create UDP socket")
}
int urc = socket_close(u)
assert(urc == 0, "UDP socket closed successfully")

