int loop_i = 0
int sum_even = 0
int sum_odd = 0
while (loop_i < 6) {
    if (loop_i % 2 == 0) {
        sum_even = sum_even + loop_i
    }
    else {
        sum_odd = sum_odd + loop_i
    }
    loop_i = loop_i + 1
}
print(sum_even)
print(sum_odd)
