int x = 15
int branch = 0
if(x == 10){
print(1)
branch = 1
}
eif(x == 15){
print(2)
branch = 2
}
else{
print(3)
branch = 3
}
assert(branch == 2, "branch should be 2")

bool b1 = x > 10
bool b2 = x < 20
assert(b1, "b1 should be true")
assert(b2, "b2 should be true")

if(b1){
print(100)
}
if(b2){
print(200)
}

int loop_i = 0
int sum_even = 0
int sum_odd = 0
while (loop_i < 6) {
    if (loop_i % 2 == 0) {
        sum_even = sum_even + loop_i
    }
    else {
        sum_odd = sum_odd + loop_i
    }
    loop_i = loop_i + 1
}
print(sum_even)
print(sum_odd)
assert(sum_even == 6, "sum_even should be 6")
assert(sum_odd == 9, "sum_odd should be 9")
