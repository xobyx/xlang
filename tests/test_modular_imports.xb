print("=== Testing Compile-Time Multi-File Modular Imports ===\n")

// Test 1: Import with string path
import "tests/mod_math.xb"

// Test 2: Redundant import of the same module (must be ignored without duplicate definition error)
import "tests/mod_math.xb"

int area = GeometryHelper.rect_area(12, 5)
int peri = GeometryHelper.rect_perimeter(12, 5)
int cube = calc_cube(4)

print("GeometryHelper.rect_area(12, 5) = %d\n", area)
print("GeometryHelper.rect_perimeter(12, 5) = %d\n", peri)
print("calc_cube(4) = %d\n", cube)

assert(area == 60, "GeometryHelper.rect_area(12, 5) == 60")
assert(peri == 34, "GeometryHelper.rect_perimeter(12, 5) == 34")
assert(cube == 64, "calc_cube(4) == 64")

// Test 3: Circular modular import handling (mod_cycle_a imports mod_cycle_b, mod_cycle_b imports mod_cycle_a)
import "tests/mod_cycle_a.xb"

int val_a = get_val_a()
int val_b = get_val_b()
print("Cycle values: val_a = %d, val_b = %d\n", val_a, val_b)
assert(val_a == 100, "val_a == 100")
assert(val_b == 200, "val_b == 200")

// Test 4: Modular import of collections without quotes
import collections

List test_list = new List()
test_list.add("modular_import_success")
print("Collections imported bare: %s\n", test_list.get(0))
assert(test_list.get(0) == "modular_import_success", "collections item matches")

print("=== Modular Imports Tests Completed Successfully ===\n")
