string s = "   Hello World 123   "
string tr = s.trim()
print("Trimmed: '%s'", tr)
assert(tr == "Hello World 123", "trim should remove leading/trailing whitespace")

string low = tr.to_lower()
print("Lower: %s", low)
assert(low == "hello world 123", "to_lower should convert to lowercase")

string up = tr.to_upper()
print("Upper: %s", up)
assert(up == "HELLO WORLD 123", "to_upper should convert to uppercase")

string sub = tr.substr(0, 5)
print("Substr: %s", sub)
assert(sub == "Hello", "substr(0, 5) should be Hello")

int idx = tr.index_of("World")
print("Index: %d", idx)
assert(idx == 6, "index_of World should be 6")

int sw = tr.starts_with("Hello")
int ew = tr.ends_with("123")
print("Starts/Ends: %d %d", sw, ew)
assert(sw == 1, "starts_with Hello should be 1")
assert(ew == 1, "ends_with 123 should be 1")

int has_num = tr.regex_match("\d+")
string num = tr.regex_find("\d+")
string rep = tr.regex_replace("\d+", "999")
print("Regex: %d, %s, %s", has_num, num, rep)
assert(has_num == 1, "has_num should be 1")
assert(num == "123", "regex_find should return 123")
assert(rep == "Hello World 999", "regex_replace should replace 123 with 999")
