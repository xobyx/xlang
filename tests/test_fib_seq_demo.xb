import "list.xb"

List get_fibonacci_sequence(int n) {
    List sequence = new List()
    if (n <= 0) {
        return sequence
    }
    if (n == 1) {
        sequence.add_int(0)
        return sequence
    }

    # Initialize the sequence with the first two numbers
    sequence.add_int(0)
    sequence.add_int(1)

    # Loop to calculate subsequent numbers
    while (sequence.size() < n) {
        int sz = sequence.size()
        int last = sequence.get_int(sz - 1)
        int prev = sequence.get_int(sz - 2)
        int next_val = last + prev
        sequence.add_int(next_val)
    }

    return sequence
}

List fib0 = get_fibonacci_sequence(0)
print(fib0.to_str())

List fib1 = get_fibonacci_sequence(1)
print(fib1.to_str())

List fib2 = get_fibonacci_sequence(2)
print(fib2.to_str())

List fib10 = get_fibonacci_sequence(10)
print(fib10.to_str())

assert(fib0.size() == 0, "fib0.size() should be 0")
assert(fib1.size() == 1, "fib1.size() should be 1")
assert(fib1.get_int(0) == 0, "fib1[0] should be 0")
assert(fib2.size() == 2, "fib2.size() should be 2")
assert(fib2.get_int(0) == 0 && fib2.get_int(1) == 1, "fib2 should be [0, 1]")
assert(fib10.size() == 10, "fib10.size() should be 10")
assert(fib10.get_int(9) == 34, "fib10[9] should be 34")

