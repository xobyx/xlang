import "fastmath"

print("Testing C extension module 'fastmath'...\n")

// Test 1: fastmath.hypot(3.0, 4.0) -> 5.0
float h = fastmath.hypot(3.0, 4.0)
print("fastmath.hypot(3.0, 4.0) = %f\n", h)
assert(h == 5.0, "fastmath.hypot should return 5.0")

// Test 2: fastmath.gcd(48, 18) -> 6
int g = fastmath.gcd(48, 18)
print("fastmath.gcd(48, 18) = %d\n", g)
assert(g == 6, "fastmath.gcd should return 6")

// Test 3: fastmath.gcd(101, 103) -> 1 (coprime primes)
int g2 = fastmath.gcd(101, 103)
print("fastmath.gcd(101, 103) = %d\n", g2)
assert(g2 == 1, "fastmath.gcd of primes should return 1")

// Test 4: fastmath.reverse("hello xlang") -> "gnalx olleh"
string rev = fastmath.reverse("hello xlang")
print("fastmath.reverse('hello xlang') = '%s'\n", rev)
assert(rev == "gnalx olleh", "fastmath.reverse should invert string")

// Test 5: SDK string formatting helper fastmath.format_stat
string stat = fastmath.format_stat("sensor", 42, 98.6)
print("fastmath.format_stat: %s\n", stat)
assert(stat == "sensor: count=42, avg=98.60", "format_stat should format correctly")

// Test 6: SDK instance reflection helper fastmath.inspect_point
class Point() {
    int x
    int y
}
Point p = new Point()
p.x = 15
p.y = 25
string pt_str = fastmath.inspect_point(p)
print("fastmath.inspect_point: %s\n", pt_str)

print("test_c_extension PASS\n")
