class Point(){
int x
int y
Point(){
x = 1
y = 2
}
Point(int a, int b){
x = a
y = b
}
}
Point p1 = new Point()
Point p2 = new Point(10, 20)
Point p3 = new Point(0, 0)
print(p1.x)
print(p1.y)
print(p2.x)
print(p2.y)
print(p3.x)
print(p3.y)

assert(p1.x == 1, "p1.x should be 1")
assert(p1.y == 2, "p1.y should be 2")
assert(p2.x == 10, "p2.x should be 10")
assert(p2.y == 20, "p2.y should be 20")
assert(p3.x == 0, "p3.x should be 0")
assert(p3.y == 0, "p3.y should be 0")

