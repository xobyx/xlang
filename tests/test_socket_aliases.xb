int s = socket("tcp")
assert(s >= 0, "socket tcp server fd valid")
socket_set_reuseaddr(s, 1)
bind(s, "127.0.0.1", 19880)
listen(s, 5)

int c = socket("tcp")
assert(c >= 0, "socket tcp client fd valid")
connect(c, "127.0.0.1", 19880)

int p = accept(s)
assert(p >= 0, "socket accept peer fd valid")
send(c, "Aliased Socket Functions")
string m = recv(p, 1024)
print("Aliased received: %s", m)
assert(m == "Aliased Socket Functions", "aliased recv matches")

close(c)
close(p)
close(s)
