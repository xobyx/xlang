class Vector2D() {
    int x
    int y

    Vector2D() {
        x = 0
        y = 0
    }

    Vector2D(int a, int b) {
        x = a
        y = b
    }

    int magnitude_squared() {
        return (x * x) + (y * y)
    }
}

Vector2D v1(3, 4)
print("Magnitude squared: %d", v1.magnitude_squared())

if (v1.magnitude_squared() == 25) {
    print("Vector is 3-4-5 triangle")
} else {
    print("Other vector")
}

int i = 0
for i (0, i + 1, i < 3) {
    print("Step: %d", i)
}
