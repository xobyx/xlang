// Comprehensive operator precedence test suite for Phase 3

// 1. Arithmetic operator precedence
int a1 = 1 + 2 * 3
if (a1 != 7) {
    print("FAIL: 1 + 2 * 3 expected 7, got %d", a1)
    exit(1)
}

int a2 = 2 * 3 + 1
if (a2 != 7) {
    print("FAIL: 2 * 3 + 1 expected 7, got %d", a2)
    exit(1)
}

int a3 = 10 - 2 * 3
if (a3 != 4) {
    print("FAIL: 10 - 2 * 3 expected 4, got %d", a3)
    exit(1)
}

int a4 = 10 - 4 - 2
if (a4 != 4) {
    print("FAIL: 10 - 4 - 2 expected 4, got %d", a4)
    exit(1)
}

int a5 = 16 / 4 / 2
if (a5 != 2) {
    print("FAIL: 16 / 4 / 2 expected 2, got %d", a5)
    exit(1)
}

int a6 = 2 + 3 * 4 + 5
if (a6 != 19) {
    print("FAIL: 2 + 3 * 4 + 5 expected 19, got %d", a6)
    exit(1)
}

int a7 = 20 / 5 * 2
if (a7 != 8) {
    print("FAIL: 20 / 5 * 2 expected 8, got %d", a7)
    exit(1)
}

int a8 = 10 + 20 / 5 * 2 - 3
if (a8 != 15) {
    print("FAIL: 10 + 20 / 5 * 2 - 3 expected 15, got %d", a8)
    exit(1)
}

// 2. Parentheses override
int p1 = (1 + 2) * 3
if (p1 != 9) {
    print("FAIL: (1 + 2) * 3 expected 9, got %d", p1)
    exit(1)
}

int p2 = 10 - (4 - 2)
if (p2 != 8) {
    print("FAIL: 10 - (4 - 2) expected 8, got %d", p2)
    exit(1)
}

int p3 = 16 / (4 / 2)
if (p3 != 8) {
    print("FAIL: 16 / (4 / 2) expected 8, got %d", p3)
    exit(1)
}

int p4 = (2 + 3) * (4 + 5)
if (p4 != 45) {
    print("FAIL: (2 + 3) * (4 + 5) expected 45, got %d", p4)
    exit(1)
}

// 3. Unary minus
int u1 = -5
if (u1 != -5) {
    print("FAIL: -5 expected -5, got %d", u1)
    exit(1)
}

int u2 = 10 * -2
if (u2 != -20) {
    print("FAIL: 10 * -2 expected -20, got %d", u2)
    exit(1)
}

int u3 = 10 - -2
if (u3 != 12) {
    print("FAIL: 10 - -2 expected 12, got %d", u3)
    exit(1)
}

int u4 = -(1 + 2)
if (u4 != -3) {
    print("FAIL: -(1 + 2) expected -3, got %d", u4)
    exit(1)
}

// 4. Comparison vs Arithmetic
bool c1 = 5 == 2 + 3
if (!c1) {
    print("FAIL: 5 == 2 + 3 expected true")
    exit(1)
}

bool c2 = 10 > 2 * 3
if (!c2) {
    print("FAIL: 10 > 2 * 3 expected true")
    exit(1)
}

bool c3 = 6 >= 2 * 3
if (!c3) {
    print("FAIL: 6 >= 2 * 3 expected true")
    exit(1)
}

bool c4 = 5 < 2 * 3
if (!c4) {
    print("FAIL: 5 < 2 * 3 expected true")
    exit(1)
}

// 5. Logical AND / OR precedence
bool l1 = true || false && false
if (!l1) {
    print("FAIL: true || false && false expected true")
    exit(1)
}

bool l2 = false && false || true
if (!l2) {
    print("FAIL: false && false || true expected true")
    exit(1)
}

bool l3 = 5 > 3 && 2 < 1
if (l3) {
    print("FAIL: 5 > 3 && 2 < 1 expected false")
    exit(1)
}

bool l4 = 5 > 3 && 1 < 2
if (!l4) {
    print("FAIL: 5 > 3 && 1 < 2 expected true")
    exit(1)
}

bool l5 = 5 < 3 || 1 < 2
if (!l5) {
    print("FAIL: 5 < 3 || 1 < 2 expected true")
    exit(1)
}

// 6. Bitwise shift precedence
int s1 = 1 << 2 + 1
if (s1 != 8) {
    print("FAIL: 1 << 2 + 1 expected 8, got %d", s1)
    exit(1)
}

int s2 = 16 >> 1 + 1
if (s2 != 4) {
    print("FAIL: 16 >> 1 + 1 expected 4, got %d", s2)
    exit(1)
}

// 7. Variables in expressions
int v_x = 5
int v_y = 10
int v_z = 2
int v_res = v_x + v_y * v_z
if (v_res != 25) {
    print("FAIL: v_x + v_y * v_z expected 25, got %d", v_res)
    exit(1)
}

bool v_cond = v_x * 2 == v_y && v_y > v_z
if (!v_cond) {
    print("FAIL: v_x * 2 == v_y && v_y > v_z expected true")
    exit(1)
}

// 8. String concatenation
string str1 = "sum: " + 1 + 2
if (str1 != "sum: 12") {
    print("FAIL: 'sum: ' + 1 + 2 expected 'sum: 12', got %s", str1)
    exit(1)
}

string str2 = "sum: " + (1 + 2)
if (str2 != "sum: 3") {
    print("FAIL: 'sum: ' + (1 + 2) expected 'sum: 3', got %s", str2)
    exit(1)
}

print("All operator precedence tests passed successfully!")
