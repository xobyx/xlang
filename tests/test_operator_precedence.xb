// Comprehensive operator precedence test suite for Phase 3

// 1. Arithmetic operator precedence
int a1 = 1 + 2 * 3
assert(a1 == 7, "1 + 2 * 3 expected 7")

int a2 = 2 * 3 + 1
assert(a2 == 7, "2 * 3 + 1 expected 7")

int a3 = 10 - 2 * 3
assert(a3 == 4, "10 - 2 * 3 expected 4")

int a4 = 10 - 4 - 2
assert(a4 == 4, "10 - 4 - 2 expected 4")

int a5 = 16 / 4 / 2
assert(a5 == 2, "16 / 4 / 2 expected 2")

int a6 = 2 + 3 * 4 + 5
assert(a6 == 19, "2 + 3 * 4 + 5 expected 19")

int a7 = 20 / 5 * 2
assert(a7 == 8, "20 / 5 * 2 expected 8")

int a8 = 10 + 20 / 5 * 2 - 3
assert(a8 == 15, "10 + 20 / 5 * 2 - 3 expected 15")

// 2. Parentheses override
int p1 = (1 + 2) * 3
assert(p1 == 9, "(1 + 2) * 3 expected 9")

int p2 = 10 - (4 - 2)
assert(p2 == 8, "10 - (4 - 2) expected 8")

int p3 = 16 / (4 / 2)
assert(p3 == 8, "16 / (4 / 2) expected 8")

int p4 = (2 + 3) * (4 + 5)
assert(p4 == 45, "(2 + 3) * (4 + 5) expected 45")

// 3. Unary minus
int u1 = -5
assert(u1 == -5, "-5 expected -5")

int u2 = 10 * -2
assert(u2 == -20, "10 * -2 expected -20")

int u3 = 10 - -2
assert(u3 == 12, "10 - -2 expected 12")

int u4 = -(1 + 2)
assert(u4 == -3, "-(1 + 2) expected -3")

// 4. Comparison vs Arithmetic
bool c1 = 5 == 2 + 3
assert(c1, "5 == 2 + 3 expected true")

bool c2 = 10 > 2 * 3
assert(c2, "10 > 2 * 3 expected true")

bool c3 = 6 >= 2 * 3
assert(c3, "6 >= 2 * 3 expected true")

bool c4 = 5 < 2 * 3
assert(c4, "5 < 2 * 3 expected true")

// 5. Logical AND / OR precedence
bool l1 = true || false && false
assert(l1, "true || false && false expected true")

bool l2 = false && false || true
assert(l2, "false && false || true expected true")

bool l3 = 5 > 3 && 2 < 1
assert(!l3, "5 > 3 && 2 < 1 expected false")

bool l4 = 5 > 3 && 1 < 2
assert(l4, "5 > 3 && 1 < 2 expected true")

bool l5 = 5 < 3 || 1 < 2
assert(l5, "5 < 3 || 1 < 2 expected true")

// 6. Bitwise shift precedence
int s1 = 1 << 2 + 1
assert(s1 == 8, "1 << 2 + 1 expected 8")

int s2 = 16 >> 1 + 1
assert(s2 == 4, "16 >> 1 + 1 expected 4")

// 7. Variables in expressions
int v_x = 5
int v_y = 10
int v_z = 2
int v_res = v_x + v_y * v_z
assert(v_res == 25, "v_x + v_y * v_z expected 25")

bool v_cond = v_x * 2 == v_y && v_y > v_z
assert(v_cond, "v_x * 2 == v_y && v_y > v_z expected true")

// 8. String concatenation
string str1 = "sum: " + 1 + 2
assert(str1 == "sum: 12", "'sum: ' + 1 + 2 expected 'sum: 12'")

string str2 = "sum: " + (1 + 2)
assert(str2 == "sum: 3", "'sum: ' + (1 + 2) expected 'sum: 3'")

print("All operator precedence tests passed successfully!\n")
