int c = get_argc()
print("Argc: %d", c)
assert(c >= 0, "argc should be at least 0")

setenv("XLANG_TEST_VAR", "hello_env")
string v = getenv("XLANG_TEST_VAR")
print("Env var: %s", v)
assert(v == "hello_env", "getenv should retrieve setenv value")

int ret = exec("echo test_exec > temp_exec.txt")
print("Exec status: %d", ret)
assert(ret == 0, "exec should return 0")

int exists = file_exists("temp_exec.txt")
print("Temp file exists: %d", exists)
assert(exists == 1, "temp_exec.txt should exist")
file_remove("temp_exec.txt")
