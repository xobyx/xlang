import "lib/json.xb"
import "lib/datetime.xb"

// 1. Test JSON is_valid
print(json_is_valid("{\"key\": \"value\"}"))
print(json_is_valid("[1, 2, 3]"))
print(json_is_valid("invalid json"))
print(json_is_valid("{unclosed"))

// 2. Test JSON.is_valid class method
print(JSON.is_valid("{\"ok\": 1}"))
print(JSON.is_valid("not json"))

// 3. Test JSON parsing and reading values
string json_text = "{\"name\": \"xlang\", \"version\": \"2.0\", \"active\": true, \"count\": 42}"
Map data = JSON.parse(json_text)
print(data.get("name"))
print(data.get("version"))
print(data.get("count"))

// 4. Test JSON serialization
data.put("status", "released")
string serialized = JSON.stringify(data)
print(JSON.is_valid(serialized))
print(data.get("status"))
data.free()

// 5. Test DateTime raw functions
int now_ts = datetime_now()
print(now_ts > 1700000000)

int y = datetime_year(now_ts)
print(y >= 2024)

int m = datetime_month(now_ts)
print(m >= 1)
print(m <= 12)

int d = datetime_day(now_ts)
print(d >= 1)
print(d <= 31)

string fmt_year = datetime_format(now_ts, "%Y")
print(fmt_year)

int ms = datetime_clock_ms()
print(ms >= 0)

// 6. Test DateTime OOP class
DateTime dt = DateTime.now()
print(dt.year() >= 2024)
print(dt.month() >= 1)
print(dt.day() >= 1)

string dt_str = dt.to_str()
print(dt_str.len() > 10)

string custom_fmt = dt.format("%Y/%m/%d")
print(custom_fmt.len() == 10)

print("test_json_datetime PASS")
