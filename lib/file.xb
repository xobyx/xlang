import "lib/list.xb"

class File() {
    string path
    int fd

    File() {
        fd = 0 - 1
    }

    File(string p) {
        path = p
        fd = 0 - 1
    }

    string read_all() {
        return file_read_all(path)
    }

    int write_all(string content) {
        return file_write_all(path, content)
    }

    int append(string content) {
        return file_append(path, content)
    }

    int exists() {
        return file_exists(path)
    }

    int size() {
        return file_size(path)
    }

    int remove() {
        return file_remove(path)
    }

    int open(string mode) {
        fd = file_open(path, mode)
        return fd
    }

    string read(int bytes) {
        return file_read(fd, bytes)
    }

    int write(string data) {
        return file_write(fd, data)
    }

    int close() {
        int rc = file_close(fd)
        fd = 0 - 1
        return rc
    }

    static string read_all_text(string p) {
        return file_read_all(p)
    }

    static int write_all_text(string p, string content) {
        return file_write_all(p, content)
    }
}

class Directory() {
    Directory() {
    }

    static List list(string path) {
        return dir_list(path)
    }

    static int create(string path) {
        return dir_create(path)
    }

    static int exists(string path) {
        return dir_exists(path)
    }

    static int remove(string path) {
        return dir_remove(path)
    }
}

